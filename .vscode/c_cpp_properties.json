{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE"
            ],
            "windowsSdkVersion": "10.0.19041.0",
            "compilerPath": "C:/MinGW/bin/gcc.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-gcc-x64"
        },
        {
            "name": "Arduino",
            "includePath": [
                "${workspaceFolder}/**",
                "C:/Program Files/Arduino IDE/**",
                "${env:USERPROFILE}/AppData/Local/Arduino15/packages/**"
            ],
            "defines": [
                "ARDUINO",
                "ARDUINO_ARCH_AVR"
            ],
            "intelliSenseMode": "gcc-x64",
            "cStandard": "c11",
            "cppStandard": "c++11"
        }
    ],
    "version": 4
}